+/** Find pwsh (PowerShell 7) in PATH; falls back to powershell.exe (5.1). */
+function findPwsh() {
+	try {
+		const { execSync } = require("child_process");
+		const w = execSync("where pwsh.exe", { encoding: "utf8", timeout: 3000, windowsHide: true }).trim();
