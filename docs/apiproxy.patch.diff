+/** Resolve the multimodal API key (env first, then local DPAPI helper), cached in-process. */
+function getMultimodalKey() {
+	if (multimodalKeyCache) return multimodalKeyCache;
+	const envKey = process.env.MULTIMODAL_API_KEY;
+	if (envKey && envKey.startsWith("sk-")) { multimodalKeyCache = envKey; return envKey; }
+	return new Promise((resolve, reject) => {
+		const env = {
+			...process.env,
+			PSModulePath: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\Modules" + (process.env.PSModulePath ? ";" + process.env.PSModulePath : "")
+		};
+		const psExe = findPwsh() || "powershell.exe";
+		const psEnv = psExe === "powershell.exe" ? {
+			...process.env,
+			PSModulePath: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\Modules" + (process.env.PSModulePath ? ";" + process.env.PSModulePath : "")
+		} : process.env;
+		execFile(psExe, [
+			"-NoProfile",
+			"-NonInteractive",
+			"-ExecutionPolicy",
+			"Bypass",
+			"-Command",
+			"& '" + MULTIMODAL_KEY_SCRIPT.replace(/'/g, "''") + "'"
+		], { windowsHide: true, maxBuffer: 1024 * 1024, timeout: 20000, env: psEnv }, (err, stdout, stderr) => {
+			if (err) { reject(new Error("multimodal: 取 API Key 失败: " + (stderr || err.message))); return; }
+			const key = stdout.trim();
+			if (!key || !key.startsWith("sk-")) { reject(new Error("multimodal: 未能从 DPAPI 存储取回有效 API Key")); return; }
