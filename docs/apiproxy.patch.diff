+	try { json = JSON.parse(text); } catch { /* 非 JSON 响应 */ }
+	if (!res.ok) {
+		const detail = json && json.error ? (json.error.message || JSON.stringify(json.error)) : text.slice(0, 300);
+		throw new Error("multimodal api " + res.status + ": " + detail);
