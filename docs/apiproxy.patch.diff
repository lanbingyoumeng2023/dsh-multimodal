+					{ type: "image_url", image_url: { url: dataUrl, detail: "high" } }
+				]
+			}]
+		}),
+		signal: AbortSignal.timeout(MULTIMODAL_DESCRIBE_TIMEOUT_MS)
+	});
+	const text = await res.text();
