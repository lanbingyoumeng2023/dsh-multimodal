# 复制为 .env 或在启动 DSH 前 export 这些变量。
# Copy to .env or export before launching DSH.

# ── 必填 / Required ──────────────────────────────────────────────────────────
# OpenAI 兼容多模态服务的 API Key（绝不写入代码/仓库）。
# API key for any OpenAI-compatible multimodal service (never commit).
MULTIMODAL_API_KEY=

# ── 服务地址 / Endpoint ─────────────────────────────────────────────────────
# OpenAI 兼容 API 基址（/chat/completions）。
# Base URL of the OpenAI-compatible API.
MULTIMODAL_BASE_URL=https://your-multimodal-provider.example.com/v1

# ── 模型名 / Model ids ───────────────────────────────────────────────────────
# 识图（图像理解）
MULTIMODAL_VISION_MODEL=your-vision-model
# 文生图 / 图编辑
MULTIMODAL_IMAGE_MODEL=your-image-model
# 文生视频 / 图生视频
MULTIMODAL_VIDEO_MODEL=your-video-model

# ── 视频轮询（仅 multimodal_generate_video 使用）─────────────────────────────
# 视频任务轮询基址与端点路径。
MULTIMODAL_VIDEO_HOST=https://your-multimodal-provider.example.com
MULTIMODAL_VIDEO_POLL_PATH=/videos/tasks?video_id=

# ── adapter 专用（可选）/ adapter-only (optional) ────────────────────────────
# 上下文窗口大小。
MULTIMODAL_CONTEXT_WINDOW=131072
